server {
        # responses are too small to benefit anything from gzip; hence it's a waste of cpu.
        gzip off;
        server_name ip.loltek.net ip4.loltek.net ip6.loltek.net;
		default_type text/plain;
        location / {
            # let cloudflare know not to cache it.
            add_header Cache-Control "no-cache, no-store";
        
            # Cloudflare
            if ($http_cf_connecting_ip != "") {
                return 200 "$http_cf_connecting_ip\n";
            }
        
            # Fastly
            if ($http_fastly_client_ip != "") {
                return 200 "$http_fastly_client_ip\n";
            }
        
            # Direct connection
            return 200 "$remote_addr\n";
        }
	listen 80;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ip.loltek.net/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ip.loltek.net/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}
